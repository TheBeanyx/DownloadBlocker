{
  "manifest_version": 3,
  "name": "CyberGuard Download Blocker",
  "version": "1.0.0",
  "description": "Védelem és letöltés blokkoló szimuláció",
  "permissions": [
    "downloads",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}