{
  "manifest_version": 3,
  "name": "CyberGuard Download Blocker",
  "version": "1.1.0",
  "description": "Jelszóval védett letöltés-blokkoló és értesítő bővítmény",
  "permissions": [
    "downloads",
    "notifications",
    "storage"
  ],
 "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
